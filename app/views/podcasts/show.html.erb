<% set_meta_tags(
  title: "Подкаст #{@podcast.name}",
  keywords: "Подкасты, Рецензии, Информация"
) %>
<!-- Slick Slider CSS -->
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick-theme.min.css" />

<!-- Slick Slider JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>

<div class="O_PodcastPage">
    <!-- Блок заголовка подкаста -->
    <div>
        <div class="M_PodcastTitle">
            <%= image_tag @podcast.cover, alt: @podcast.cover, class: "PodcastCover" if @podcast.cover.present? %>
            <div class="PodcastText">
                <div class="Title">
                    <h1> Подкаст «<%= @podcast.name %>»</h1>
                    <div>
                        <div id="extra-button-wrapper" style="display: none;">
                            <% if @author.present? && @author.podcasts.include?(@podcast) %>
                            <%= link_to edit_podcast_path(@podcast) do %>
                            <div class="A_Button SecondaryMedium">
                                <h5> Редактировать</h5>
                            </div>
                            <%end%>
                            <% else %>
                            <div class="A_Button SecondaryMedium">
                                <h5> Это ваш подкаст?</h5>
                            </div>
                            <%end%>
                        </div>

                        <%= link_to toggle_favorite_podcast_path(@podcast.id, type: "Podcast"), method: :get, class: "favorite-button" do %>
                        <div class="Q_Like <%= 'accent' if @favorited_podcasts&.include?(@podcast.id) %>">
                        </div>
                        <% end %>

                        <div class="Q_Icon more" id="toggle-button"></div>
                    </div>
                </div>
                <p><%= @podcast.description%> </p>
                <div>
                    <div class="PodcastAuthors">
                        <% @podcast.authors.each do |author| %>
                        <%= link_to author_path(author) do %>
                        <div class="PodcastAuthorCard">

                            <%= image_tag author.user.profile.avatar, alt: "Avatar Image", class:"PodcastAuthorAvatar" %>
                            <div class="AuthorCard">
                                <h5><%= author.user.profile.name%> </h5>
                                <p class="small"><%= author.exten_bio %> </p>
                            </div>

                        </div>
                        <% end %>
                        <% end %>
                    </div>
                </div>
                <div class="PodcastThemes">
                    <% if @podcast.themes.any? %>
                    <% @podcast.themes.each do |theme| %>
                    <%= link_to theme_path(theme) do %>
                    <div class="A_Tag">
                        <h5><%= theme.name %></h5>
                    </div>
                    <%end%>
                    <% end %>
                    <% else %>
                    <p>Этот подкаст пока не имеет тегов.</p>
                    <% end %>
                </div>
            </div>
        </div>
        <!-- Темы подкаста -->
        <div class="W_LinksLine_Title">
            <p>Слушать на</p>
            <div class="C_LinksLine">
                <% if @podcast.external_links.any? %>
                <% @podcast.external_links.each do |link| %>
                <div class="A_Link">
                    <a href="<%= link['url'] %>" target="_blank"><%= link['service'] %></a>
                </div>
                <% end %>
                <% else %>
                <p>Нет внешних ссылок</p>
                <% end %>
            </div>
        </div>
    </div>
    <div class="W_ToggleList">
        <h3 class="toggle-button active" data-id="all">ВСЕ</h3>
        <h3 class="toggle-button" data-id="new">ВЫПУСКИ</h3>
        <h3 class="toggle-button" data-id="chart">РЕЙТИНГ</h3>
        <h3 class="toggle-button" data-id="selections">ОБСУЖДЕНИЯ</h3>
    </div>
    <div class="W_Content">
        <div class="toggle-content C_PodcastAll" data-id="all">

            <!-- Галерея аудиовыпусков -->
            <div class="podcastsIssues">
                <div class="W_ListBlock_Title">
                    <h2>Лучшие аудиовыпуски</h2>
                    <%= link_to podcast_issues_path(@podcast) do %>
                    <h4>посмотреть все</h4>
                    <% end %>
                </div>
                <div class="slider">
                    <% @audio_issues.each do |issue| %>
                    <div class="slider__item">
                        <%= render partial: "issueaudiocard_secondary", locals: { issue: issue } %>
                    </div>
                    <% end %>
                </div>
            </div>

            <!-- Галерея выпусков -->
            <div class="podcastsIssues">
                <div class="W_ListBlock_Title">
                    <h2>Лучшие видеовыпуски</h2>
                    <%= link_to podcast_issues_path(@podcast) do %>
                    <h4>посмотреть все</h4>
                    <% end %>
                </div>

                <div class="slider audio">
                    <% @video_issues.each do |issue| %>
                    <div class="slider__item video">
                        <%= render partial: "issuecard_secondary", locals: { issue: issue } %>
                    </div>
                    <% end %>
                </div>


            </div>

            <!-- Секция отзывов -->
            <div class="W_ReviewBlock">
                <h2> Рейтинг подкаста </h2>
                <div class="C_ReviewStars">
                    <div class="Stars">
                        <div class="Q_Icon star fill">
                        </div>
                        <div class="Q_Icon star fill">
                        </div>
                        <div class="Q_Icon star fill">
                        </div>
                        <div class="Q_Icon star fill">
                        </div>
                        <div class="Q_Icon star ">
                        </div>
                    </div>
                    <h1 style="font-size: 55px; color: var(--accent_green)"> 4.6 </h1>
                    <p class="mini"> Оценили 20459 <br> пользователей </p>
                </div>
                <div class="C_ThemeReview">
                    <div class="W_ThemeCountCard">
                        <h1 class="extra"> 76% </h1>
                        <p> Интересная тема обсуждений</p>
                    </div>
                    <div class="W_ThemeCountCard">
                        <h1 class="extra"> 46% </h1>
                        <p> Глубокий анализ материала</p>
                    </div>
                    <div class="W_ThemeCountCard">
                        <h1 class="extra"> 8% </h1>
                        <p> Хорошая динамика беседы</p>
                    </div>
                    <div class="W_ThemeCountCard">
                        <h1 class="extra"> 40% </h1>
                        <p> Доступность <br>
                            и понятность</p>
                    </div>
                    <div class="W_ThemeCountCard">
                        <h1 class="extra"> 79% </h1>
                        <p> Оригинальность <br>
                            и инсайды</p>
                    </div>
                    <div class="W_ThemeCountCard">
                        <h1 class="extra"> 46% </h1>
                        <p> Структура повествования</p>
                    </div>
                </div>


            </div>
            <div class="W_FeedbackBlock">
                <h2> Отзывы слушателей </h2>
                <div class="W_ReviewCards">
                    <% @reviews.each do |review| %>
                    <% if review.content.present? %>
                    <%= render partial: "reviewcard", locals: { review: review } %>
                    <% end %> <% end %>
                </div>
            </div>
            <div class="Feed_Add">
                <div class="Column1">
                    <% if current_user.present? %>
                    <div class="C_Feedbacks">
                        <div class="W_FeedbackCard">
                            <%= render "reviews/form" %>
                        </div>
                    </div>
                    <% end %>

                    <div class="W_SamePodcasts">
                        <h2> Похожее </h2>
                        <div class="C_PodcastsSame">
                            <% @same_podcasts.each do |podcast| %>
                            <%= render partial: "podcastcard", locals: { podcast: podcast } %>
                            <% end%>
                        </div>
                    </div>
                    <!-- Секция постов -->
                    <div class="O_LentaPosts">
                        <div class="W_DiscussFeed">

                            <h2>Лента авторов</h2>



                            <div class="C_Discuss">
                                <% if current_user.present? && current_user.is_author? && current_user.author.podcasts.include?(@podcast) %>
                                <div class="W_CreatePostForPodcast">

                                    <div class="C_TopCreatingLine">

                                        <div class="InfoLine">
                                            <%= image_tag @podcast.cover, alt: "Обложка подкаста", class: "UserAvatar" %>
                                            <h4 style="font-weight:500">Подкаст «<%= @podcast.name %>»</h4>
                                        </div>

                                        <div class="InfoLine">
                                            <p class="small">Формат поста: </p>
                                            <div class="A_Tag format-selector">
                                                <select id="post_format_select" class="unstyled-select">
                                                    <option value="post" selected>Пост</option>
                                                    <option value="issue">Выпуск</option>
                                                </select>

                                            </div>
                                        </div>

                                    </div>

                                    <!-- Форма поста -->
                                    <div id="post_form_block">
                                        <%= form_with model: @post, url: posts_path, method: :post, local: true do |f| %>
                                        <h2>
                                            <%= f.text_field :title, placeholder: "Заголовок", class: "unstyled-input" %>
                                        </h2>
                                        <p>
                                            <%= f.text_area :content, placeholder: "Описание", class: "unstyled-textarea" %>
                                        </p>





                                        <%= f.hidden_field :podcast_id, value: @podcast.id %>
                                        <%= f.hidden_field :date, value: Time.current %>

                                        <div class="W_IssueFullCard_Footer">
                                            <div class="Footer">
                                                <div class="CommentFeedback">
                                                    <div class="Q_HandLike"></div>
                                                    <div class="Q_HandLike dislike"></div>



                                                </div>
                                                <div class="SubmitButton">
                                                    <%= f.submit "Опубликовать", class: "A_Button PrimaryMedium" %>
                                                </div>
                                            </div>
                                        </div>

                                        <% end %>
                                    </div>

                                    <!-- Форма выпуска (пока демонстрационная) -->
                                    <div id="issue_form_block" style="display: none;">
                                        <%= form_with model: @issue, url: issues_path, method: :post, local: true, html: { multipart: true } do |f| %>
                                        <h2>
                                            <%= f.text_field :name, placeholder: "Название выпуска", class: "unstyled-input" %>
                                        </h2>
                                        <p>
                                            <%= f.text_area :description, placeholder: "Описание выпуска", class: "unstyled-textarea" %>
                                        </p>
                                        <div class="C_InputLine">
                                            <div class="A_Tag">
                                                <label for="cover_upload">
                                                    <div class="Q_Icon image"></div>
                                                    <span id="upload_text">Загрузить обложку</span>
                                                </label>

                                                <%= f.file_field :cover, id: "cover_upload", class: "HiddenFileInput" %>
                                            </div>

                                            <%= f.hidden_field :podcast_id, value: @podcast.id %>
                                            <div class="A_Tag">
                                                <div class="Q_Icon link"> </div>
                                                <%= label_tag "Ссылка:" %>
                                                <%= f.text_field :link, placeholder: "Ссылка", class: "unstyled-textarea link-input" %>
                                            </div>
                                        </div>
                                        <div class="W_IssueFullCard_Footer">
                                            <div class="Footer">
                                                <div class="CommentFeedback">
                                                    <div class="Q_HandLike"></div>
                                                    <div class="Q_HandLike dislike"></div>

                                                    <div class="SubmitButton">
                                                        <%= f.submit "Создать выпуск", class: "A_Button PrimaryMedium" %>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                        <% end %>
                                    </div>

                                </div>
                                <% end %>
                                <% @content_items.each do |item| %>
                                <% if item.is_a?(Issue) %>
                                <%= render partial: "showissuecard", locals: { issue: item } %>
                                <% elsif item.is_a?(Post) %>
                                <%= render partial: "postcard", locals: { post: item } %>
                                <% end %>
                                <% end %>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="2Column">
                    <%= link_to "https://t.me/tolki_hse" do %>
                    <div class="AdvertBlock">
                    </div>
                    <% end %>
                </div>
            </div>
        </div>
        <div class="toggle-content hidden" data-id="new">
            <div class="C_AllIssues">
                <% @issues.each do |issue| %>

                <%= render partial: "issuecard_secondary", locals: { issue: issue } %>

                <% end %>

            </div>
        </div>
        <div class="toggle-content hidden" data-id="chart">
            <div class="W_FeedbackBlock">
                <h2> Отзывы слушателей </h2>
                <div class="W_ReviewCards">
                    <% @reviews.each do |review| %>
                    <% if review.content.present? %>
                    <%= render partial: "reviewcard", locals: { review: review } %>
                    <% end %> <% end %>
                </div>
                <% if current_user.present? %>
                <div class="C_Feedbacks">
                    <div class="W_FeedbackCard">
                        <%= render "reviews/form" %>
                    </div>
                </div>
                <% end %>
            </div>

        </div>
        <div class="toggle-content hidden" data-id="selections">
            <div class="Feed_Add">
                <div class="Column1">
                    <div class="O_LentaPosts">
                        <div class="W_DiscussFeed">

                            <h2>Лента авторов</h2>
                            <div class="W_CreatePostForPodcast">
                                <div class="C_TopCreatingLine">

                                    <div class="PodcastInfo">
                                        <%= image_tag @podcast.cover, alt: "Обложка подкаста", class: "PodcastCoverImage" %>
                                        <h5 class="Medium"><%= @podcast.name %></h5>
                                    </div>

                                    <div class="PostFormat">
                                        <p class="Text14">Формат поста</p>
                                        <div class="A_Tag">
                                            <p class="Text16 Medium">Обсуждение</p>
                                            <div class="Icon"></div>
                                        </div>
                                    </div>

                                </div>

                                <%= form_with model: @post, url: posts_path, method: :post, local: true do |f| %>

                                <%= f.text_field :title, placeholder: "Заголовок", class: "A_Input" %>
                                <%= f.text_area :content, placeholder: "Описание", class: "A_Input" %>

                                <div class="TagsWrapper">
                                    <% ["Наука", "Технологии", "Интервью", "Рецензия"].each do |tag| %>
                                    <div class="A_Tag">
                                        <div class="Icon"></div>
                                        <p class="Text14"><%= tag %></p>
                                    </div>
                                    <% end %>
                                </div>

                                <!-- Скрытые поля для связи поста с подкастом и автором -->
                                <%= f.hidden_field :podcast_id, value: @podcast.id %>
                                <%= f.hidden_field :date, value: Time.current %>

                                <div class="W_IssueFullCard_Footer">
                                    <div class="Footer">
                                        <div class="CommentFeedback">
                                            <div class="Q_HandLike"></div>
                                            <div class="Q_HandLike dislike"></div>

                                            <div class="SubmitButton">
                                                <%= f.submit "Создать", class: "A_Button PrimaryMedium" %>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                                <% end %>
                            </div>

                            <div class="C_Discuss">
                                <% @content_items.each do |item| %>
                                <% if item.is_a?(Issue) %>
                                <%= render partial: "showissuecard", locals: { issue: item } %>
                                <% elsif item.is_a?(Post) %>
                                <%= render partial: "postcard", locals: { post: item } %>
                                <% end %>
                                <% end %>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="Column2">
                    <%= link_to "https://t.me/tolki_hse" do %>
                    <div class="AdvertBlock">
                    </div>
                    <% end %>
                </div>
            </div>
        </div>
    </div>

</div>

</div>
<%= javascript_tag do %>
$(document).ready(function() {
/* Small card slider */
$('.slider').slick({
arrows: false,
dots: false,
infinite: true,
initialSlide: 0,
slidesToScroll: 1,
slidesToShow: 3
});

const slider = $(".slider");
var scrollCount = null;
var scroll= null;

slider.on('wheel', function(e) {
e.preventDefault();

clearTimeout(scroll);
scroll = setTimeout(function(){scrollCount=0;}, 200);
if(scrollCount) return 0;
scrollCount=1;

if (e.originalEvent.deltaY < 0) { $(this).slick('slickNext'); } else { $(this).slick('slickPrev'); } }); }); $(document).ready(function() { $('.slider').slick({ slidesToShow: 4, slidesToScroll: 1, infinite: true }); }); document.addEventListener('DOMContentLoaded', function () { const toggleButton=document.getElementById('toggle-button'); const extraWrapper=document.getElementById('extra-button-wrapper'); toggleButton.addEventListener('click', function () { if (extraWrapper.style.display==='none' ) { extraWrapper.style.display='inline-block' ; } else { extraWrapper.style.display='none' ; } }); }); <% end %> <%= javascript_tag do %> document.addEventListener("DOMContentLoaded", function() { const formatSelect=document.getElementById("post_format_select"); const postForm=document.getElementById("post_form_block"); const issueForm=document.getElementById("issue_form_block"); formatSelect.addEventListener("change", function() { if (this.value==="post" ) { postForm.style.display="block" ; issueForm.style.display="none" ; } else { postForm.style.display="none" ; issueForm.style.display="block" ; } }); }); <% end %> <script>
    document.addEventListener("DOMContentLoaded", function() {
    const fileInput = document.getElementById("cover_upload");
    const uploadText = document.getElementById("upload_text");

    fileInput.addEventListener("change", function() {
    if (fileInput.files.length > 0) {
    uploadText.textContent = fileInput.files[0].name;
    } else {
    uploadText.textContent = "Загрузить обложку";
    }
    });
    });
    </script>