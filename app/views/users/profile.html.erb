<% set_meta_tags(
  title: "Профиль замечательного пользователя – #{@user.profile.name}",
  keywords: "Подкасты, Рецензии, Информация"
) %>


<div class="O_Profile">
    <div class="M_ProfileCardOpened">
        <div style="display:flex; gap:16px">
            <%= image_tag @user.profile.avatar, alt: @user.profile.name, class: "ProfileAvatarImage" if @user.profile.avatar.present? %>
            <div class="ProfileTitle">

                <h1> <%= @user.profile.name %> </h1>
                <p> Знаток подкастов <%= @user.profile.level %> уровня </p>

                <div class="C_SectionList">
                    <div class="A_section Small">
                        <h4>Подписок: <%= current_user.subscribed_authors.count %> </h4>

                    </div>

                </div>
            </div>
        </div>
        <div class="ProfileFunc">
            <%= button_to destroy_user_session_path, method: :delete, class: "A_Button SecondaryMedium white" do %>
            <h5> Выйти </h5>
            <% end %>
            <%= link_to edit_profile_path(@user.id), class: "Q_Icon setting" do %>
            <% end %>
        </div>
    </div>
    <% if @user.is_author && @author.podcasts.any? %>
    <div class="W_ProfilePlaylistBlock">
        <h1>Подкасты</h1>
        <div class="C_AuthorsCards">
            <% @podcasts.each do |podcast| %>
            <%= render partial: "podcastcard", locals: { podcast: podcast } %>
            <% end %>
        </div>
        <%= link_to new_podcast_path, class: "A_Button Primary", role: "button" do %>
        <h3>Добавить подкаст</h3>
        <% end %>
    </div>
    <% end %>
    <div class="W_ProfilePlaylistBlock">
        <h1>Плейлист </h1>
        <div class="C_ProfilePlaylist">
            <% @playlists.each do |playlist| %>
            <%= link_to playlist_path(playlist) do %>
            <div class="M_PlaylistCard">
                <%= image_tag "theme_cover/#{playlist.cover.presence || 'theme_cover_1'}.png", alt: "ALT", class: "PlaylistCover" %>
                <p><%= playlist.name %></p>
            </div>
            <%end%>
            <%end%>
            <%= link_to new_playlist_path() do %>
            <div class="M_PlaylistCard">
                <%= image_tag "PlayListAdd.png", alt: "ALT", class: "PlaylistCover" %>
            </div>
            <%end%>
        </div>
    </div>
    <div class="W_ToggleList">
        <h3 class="toggle-button active" data-id="all">ВСЕ</h3>
        <h3 class="toggle-button" data-id="comm">КОММЕНТАРИИ</h3>
        <h3 class="toggle-button" data-id="review">ОТЗЫВЫ</h3>
        <h3 class="toggle-button" data-id="liked">ЛАЙКИ</h3>
    </div>
    <div class="toggle-content" data-id="all">
        <div class="C_PostCardsList short">
            <div class="W_ListBlock_Title">
                <h2> Ваши комментарии под постами </h2>
                <%= link_to "#", class: "see-all-link", data: { target_tab: "comm" } do %>
                <h4>посмотреть все</h4>
                <% end %>
            </div>

            <% if @last_commentable.present? %>
            <% if @last_commentable.is_a?(Issue) %>
            <%= render partial: "showissuecard", locals: { issue: @last_commentable } %>
            <% elsif @last_commentable.is_a?(Post) %>
            <%= render partial: "postcard", locals: { post: @last_commentable } %>
            <% else %>
            <p>Комментарий к <%= @last_commentable.class.name %></p>
            <% end %>
            <% else %>
            <p>Пока ничего нет</p>
            <% end %>
        </div>

        <div class="C_PostCardsList">
            <div class="W_ListBlock_Title">
                <h2> Ваши отзывы </h2>
                <%= link_to "#", class: "see-all-link", data: { target_tab: "review" } do %>
                <h4>посмотреть все</h4>
                <% end %>
            </div>

            <% if @reviews.any? %>
            <div class="W_ReviewBlock">
                <div class="C_ReviewProfile">
                    <% @reviews.each do |review| %>
                    <%= render partial: "reviewcard", locals: { review: review } %>
                    <% end %>
                </div>
            </div>
            <% else %>
            <p>Пока ничего нет</p>
            <% end %>
        </div>

        <div class="C_PostCardsList short">


            <% if @liked_posts1.any? || @liked_issues1.any? %>
            <div class="W_ListBlock_Title">
                <h2> Лайки </h2>
                <%= link_to "#", class: "see-all-link", data: { target_tab: "liked" } do %>
                <h4>посмотреть все</h4>
                <% end %>
            </div>
            <% @liked_posts1.each do |post| %>
            <%= render partial: "postcard", locals: { post: post } %>
            <% end %>
            <% @liked_issues1.each do |issue| %>
            <%= render partial: "showissuecard", locals: { issue: issue } %>
            <% end %>
            <% else %>

            <% end %>
        </div>
    </div>

    <div class="toggle-content" data-id="comm">
        <div class="C_PostCardsList short">
            <% if @commented_posts.any? || @commented_issues.any? %>
            <% @commented_posts.each do |post| %>
            <%= render partial: "postcard", locals: { post: post } %>
            <% end %>

            <% @commented_issues.each do |issue| %>
            <%= render partial: "showissuecard", locals: { issue: issue } %>
            <% end %>
            <% else %>
            <p>Пока ничего нет</p>
            <% end %>
        </div>
    </div>

    <div class="toggle-content" data-id="review">
        <div class="C_PostCardsList">
            <% if @reviews_all.any? %>
            <div class="W_ReviewBlock">
                <div class="C_ReviewProfile">
                    <% @reviews_all.each do |review| %>
                    <%= render partial: "reviewcard", locals: { review: review } %>
                    <% end %>
                </div>
            </div>
            <% else %>
            <p>Пока ничего нет</p>
            <% end %>
        </div>
    </div>

    <div class="toggle-content" data-id="liked">
        <div class="C_PostCardsList">
            <% if @liked_posts.any? || @liked_issues.any? %>
            <% @liked_posts.each do |post| %>
            <%= render partial: "postcard", locals: { post: post } %>
            <% end %>
            <% @liked_issues.each do |issue| %>
            <%= render partial: "showissuecard", locals: { issue: issue } %>
            <% end %>
            <% else %>
            <h5>Пока ничего нет</h5>
            <% end %>
        </div>
    </div>


</div>

<%= javascript_tag do %>
document.addEventListener("DOMContentLoaded", function () {
const buttons = document.querySelectorAll(".toggle-button");
const contents = document.querySelectorAll(".toggle-content");

function activateTab(id) {
buttons.forEach(btn => btn.classList.remove("active"));
contents.forEach(content => content.style.display = "none");

const activeButton = document.querySelector(`.toggle-button[data-id="${id}"]`);
const activeContent = document.querySelector(`.toggle-content[data-id="${id}"]`);

if (activeButton) activeButton.classList.add("active");
if (activeContent) activeContent.style.display = "block";
}

const defaultTab = document.querySelector(".toggle-button.active")?.dataset.id || "all";
activateTab(defaultTab);

buttons.forEach(btn => {
btn.addEventListener("click", () => {
activateTab(btn.dataset.id);
});
});

// Новая часть: клик по ссылке "посмотреть все"
document.querySelectorAll(".see-all-link").forEach(link => {
link.addEventListener("click", (e) => {
e.preventDefault();
const targetTab = link.dataset.targetTab;
activateTab(targetTab);
});
});
});
<% end %>